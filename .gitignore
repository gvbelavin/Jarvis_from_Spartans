# Корневой .gitignore проекта «Джарвис».
#
# В репозиторий не должны попадать: базы данных, аудиозаписи, веса моделей
# и прочие большие артефакты. Модели и эталонные записи готовятся локально
# по инструкции соответствующих подмодулей.

# --- Python ---------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env

# --- Данные и артефакты локального запуска --------------------------------
# Базы памяти (jarvis_memory: шаг 2 плана — SQLite)
*.db
*.sqlite
*.sqlite3

# Аудиозаписи и промежуточные файлы
*.wav
*.mp3
*.flac

# Веса моделей: Whisper, Piper, эмбеддинги
*.onnx
*.onnx.json
*.bin
*.rknn
*.rkllm
*.gguf
*.pt
*.pth

# Локальная настройка аудиомодуля (пути к эталонным записям)
paths.py

# --- Редакторы и ОС -------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
